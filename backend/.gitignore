# =============================================================================
# Backend .gitignore
# =============================================================================

# Dependencies
node_modules/
npm-debug.log*

# Build output
dist/
build/

# Environment variables & secrets — NEVER commit these
.env
.env.local
.env.*.local
serviceAccountKey.json
firebase-service-account.json
*.key
*.pem

# Logs
logs/
*.log
yarn-error.log

# Testing
coverage/
.nyc_output/

# Process IDs
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
